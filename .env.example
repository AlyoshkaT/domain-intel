# ==============================================================================
# domain-intel — configuration template
# ------------------------------------------------------------------------------
# Copy to `.env` and fill in secrets:  cp .env.example .env
#
# Every value below is read in ONE place: config/settings.py (the single source
# of truth). No other module reads env directly. To change a knob, either edit
# the default in config/settings.py or override it here.
#
# Format:  # <what it does — bigger/smaller means what> | used in: <file>
#          KEY=<default>
# Secrets are shown as <...> placeholders — never commit real values.
# ==============================================================================

# ─── BigQuery: projects / datasets / credentials ─────────────────────────────
# Private project (app's own tables) and corp project (shared source data).
GCP_PROJECT_ID=esoteric-parsec-147012
BIGQUERY_LOCATION=EU
BIGQUERY_DATASET=es_analysis
CORP_PROJECT_ID=esoteric-parsec-147012
CORP_DATASET=es_analysis
# Credentials. Local: path to JSON. Railway: inline JSON in *_CREDENTIALS_JSON.
GOOGLE_APPLICATION_CREDENTIALS=<path/to/service-account.json>
GOOGLE_CORP_CREDENTIALS=<path/to/corp-service-account.json>
# Max GB a single BQ query may bill — cost guard. | used in: core/bigquery.py
BQ_MAX_BYTES_BILLED_GB=10

# ─── External API keys (SECRETS) ─────────────────────────────────────────────
SIMILARWEB_RAPIDAPI_KEY=<rapidapi-key>
BUILTWITH_API_KEY=<builtwith-key>
BUILTWITH_RAPIDAPI_KEY=<rapidapi-key>
ANTHROPIC_API_KEY=<sk-ant-...>
PIPEDRIVE_API_TOKEN=<pipedrive-token>
PIPEDRIVE_COMPANY_DOMAIN=<yourcompany>   # the <sub> in <sub>.pipedrive.com

# ─── Google Sheets / Drive ───────────────────────────────────────────────────
GOOGLE_SHEETS_CATALOG_ID=<sheet-id>
GOOGLE_SHEETS_CREDENTIALS=<path-or-json>

# ─── Concurrency — the main SPEED levers ─────────────────────────────────────
# Domains processed in parallel. Biggest throughput knob. ~20 is the sweet spot;
# >20 starts triggering SimilarWeb 429s (measured). | used in: processing/batch.py
BATCH_CONCURRENCY=20
# Per-service API caps (independent lanes). Default = BATCH_CONCURRENCY.
# SW kept lower on purpose — RapidAPI throttles bursts. | used in: processing/limits.py
SW_CONCURRENCY=6      # SimilarWeb
BW_CONCURRENCY=20     # BuiltWith
AI_CONCURRENCY=20     # Claude
# Jobs with ≤ this many domains pre-empt big jobs' new API calls (fast small runs).
PRIORITY_MAX_DOMAINS=10

# ─── Job lifecycle — crash recovery & cross-process safety ───────────────────
# A running job's owner refreshes a BQ "lease" (updated_at + live counts) every
# N seconds. Stops the same job running in two processes at once (double BQ cost)
# and keeps counters consistent across local/web. | used in: processing/batch.py
JOB_HEARTBEAT_SECONDS=45
# On startup, only auto-resume jobs whose lease is older than this (owner gone).
# Must be > JOB_HEARTBEAT_SECONDS. | used in: api/main.py, core/bigquery.py
JOB_STALE_RESUME_MINUTES=5

# ─── HTTP timeouts (seconds) ─────────────────────────────────────────────────
REQUEST_TIMEOUT=12          # SimilarWeb API call        | services/similarweb.py
REDIRECT_TIMEOUT=3          # domain redirect probe      | services/redirect_resolver.py
HOMEPAGE_TIMEOUT=10         # homepage fetch for AI       | services/claude_ai.py
AI_API_TIMEOUT=30           # Anthropic messages call     | services/claude_ai.py
PIPEDRIVE_TIMEOUT=30        # Pipedrive REST              | services/pipedrive.py
BUILTWITH_WHOAMI_TIMEOUT=10 # BuiltWith credit check      | services/credits.py

# ─── Retries & pauses ────────────────────────────────────────────────────────
SW_MAX_RETRIES=5            # SimilarWeb 429 retry attempts        | services/similarweb.py
RATE_LIMIT_WAIT=10          # base backoff (s) after a 429; grows exponentially
DELAY_BETWEEN_DOMAINS=0     # extra pause per domain (s), 0 = off  | processing/batch.py
DELAY_BETWEEN_API_CALLS=300 # pause between SW→BW→AI calls (ms)    | processing/pipeline.py

# ─── Scheduler — daily auto-sync hours (UTC) ─────────────────────────────────
# All | used in: api/scheduler.py
SYNC_HOUR_UTC=4             # domain_profiles full sync
PARSED_SYNC_HOUR_UTC=3      # corpBQ raw → privateBQ parsed
PIPEDRIVE_SYNC_HOUR_UTC=2   # Pipedrive relationship status
PIPEDRIVE_MRR_HOUR_UTC=1    # Pipedrive MRR pull from corpBQ
RESET_BQ_LIMIT_HOUR_UTC=0   # reset the BQ byte guard
BQ_LIMIT_DAILY_RESET_GB=25  # target value that reset restores

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_TTL_DAYS=90           # how long raw API cache is considered fresh

# ─── Auth ────────────────────────────────────────────────────────────────────
# HTTP Basic users, plaintext "user:pass" comma-separated. | used in: api/auth.py
AUTH_USERS=<user:pass,user2:pass2>
